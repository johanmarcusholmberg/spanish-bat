# Required: Your Clerk publishable key (starts with pk_test_ or pk_live_)
# Get this from https://dashboard.clerk.com → your app → API Keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Required: Full URL to the API backend (including /api suffix)
# In Replit dev this is injected automatically by the workflow
# In production set this to your deployed domain, e.g. https://murcielingo.app/api
EXPO_PUBLIC_API_BASE_URL=https://your-replit-dev-domain.repl.co/api
